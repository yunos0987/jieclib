(*
 * $ cd <JiecLib Project Root>
 * $ jiecc ./test/hash/test_hash.iec -I. -I./src -I./vendor/jiecunit -D_TEST_ -o ./test/hash/test_hash.xml -t omron
 *)
{#include <jiecunit.iec>}
{#if _JIECUNIT and (_JIECUNIT_VER < 402)}
	{#error This test requires JiecUnit 4.2 or later.}
{#endif}

{#ifdef _TEST_}
DEFINE_CONFIGURATION(
	_JIEC_TESTNAMES_LIST_(
		test_CRC32_string,
		test_CRC32_bytes,
		test_MD5_string,
		test_MD5_bytes,
		test_SHA1_string,
		test_SHA1_bytes,
		test_SHA256_string,
		test_SHA256_bytes,
		test_SHA512_string,
		test_SHA512_bytes,
		test_CRC16_modbus,
		test_CRC16_ccittFalse,
		test_CRC16_xmodem,
		test_CRC16_toHex,
		test_Checksum_sum8,
		test_Checksum_xor8,
		test_Checksum_lrc
	)
)
{#undef _TEST_}
{#endif}

{#include "test_crc32.iec"}
{#include "test_md5.iec"}
{#include "test_sha1.iec"}
{#include "test_sha256.iec"}
{#include "test_sha512.iec"}
{#include "test_crc16.iec"}
{#include "test_checksum.iec"}
