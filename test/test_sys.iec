(*
 * $ cd <JiecLib Project Root>
 * $ jiecc ./test/test_sys.iec -I./src -I./vendor/jiecunit -D_TEST_ -o ./test/test_sys.xml -t omron
 *)
{#include <jiecunit.iec>}
{#if _JIECUNIT and (_JIECUNIT_VER < 402)}
	{#error This test requires JiecUnit 4.2 or later.}
{#endif}

{#include <sys.iec>}

{#ifdef _TEST_}
DEFINE_CONFIGURATION(
	_JIEC_TESTNAMES_LIST_(
		test_udint_to_string,
		test_dint_to_string,
		test_lreal_to_string,
		test_bool_to_string,
		test_time_to_literal,
		test_jiec_time_quotient,
		test_jiec_concat,
		test_jiec_quote
	)
)
{#undef _TEST_}
{#endif}

{#include "test_sys_conv.iec"}

TEST_S(test_jiec_concat)
	// 0~16
	EXPECT_EQ_STRING('', jiec_concat());
	EXPECT_EQ_STRING('ab', jiec_concat('ab'));
	EXPECT_EQ_STRING('abcd', jiec_concat('ab', 'cd'));
	EXPECT_EQ_STRING('abcdef', jiec_concat('ab', 'cd', 'ef'));
	EXPECT_EQ_STRING('abcdefgh', jiec_concat('ab', 'cd', 'ef', 'gh'));
	EXPECT_EQ_STRING('abcdefghij', jiec_concat('ab', 'cd', 'ef', 'gh', 'ij'));
	EXPECT_EQ_STRING('abcdefghijkl', jiec_concat('ab', 'cd', 'ef', 'gh', 'ij', 'kl'));
	EXPECT_EQ_STRING('abcdefghijklmn', jiec_concat('ab', 'cd', 'ef', 'gh', 'ij', 'kl', 'mn'));
	EXPECT_EQ_STRING('abcdefghijklmnop', jiec_concat('ab', 'cd', 'ef', 'gh', 'ij', 'kl', 'mn', 'op'));
	EXPECT_EQ_STRING('abcdefghijklmnopqr', jiec_concat('ab', 'cd', 'ef', 'gh', 'ij', 'kl', 'mn', 'op', 'qr'));
	EXPECT_EQ_STRING('abcdefghijklmnopqrst', jiec_concat('ab', 'cd', 'ef', 'gh', 'ij', 'kl', 'mn', 'op', 'qr', 'st'));
	EXPECT_EQ_STRING('abcdefghijklmnopqrstuv', jiec_concat('ab', 'cd', 'ef', 'gh', 'ij', 'kl', 'mn', 'op', 'qr', 'st', 'uv'));
	EXPECT_EQ_STRING('abcdefghijklmnopqrstuvwx', jiec_concat('ab', 'cd', 'ef', 'gh', 'ij', 'kl', 'mn', 'op', 'qr', 'st', 'uv', 'wx'));
	EXPECT_EQ_STRING('abcdefghijklmnopqrstuvwxyz', jiec_concat('ab', 'cd', 'ef', 'gh', 'ij', 'kl', 'mn', 'op', 'qr', 'st', 'uv', 'wx', 'yz'));
	EXPECT_EQ_STRING('abcdefghijklmnopqrstuvwxyzAB', jiec_concat('ab', 'cd', 'ef', 'gh', 'ij', 'kl', 'mn', 'op', 'qr', 'st', 'uv', 'wx', 'yz', 'AB'));
	EXPECT_EQ_STRING('abcdefghijklmnopqrstuvwxyzABCD', jiec_concat('ab', 'cd', 'ef', 'gh', 'ij', 'kl', 'mn', 'op', 'qr', 'st', 'uv', 'wx', 'yz', 'AB', 'CD'));
	EXPECT_EQ_STRING('abcdefghijklmnopqrstuvwxyzABCDEF', jiec_concat('ab', 'cd', 'ef', 'gh', 'ij', 'kl', 'mn', 'op', 'qr', 'st', 'uv', 'wx', 'yz', 'AB', 'CD', 'EF'));
	//
	EXPECT_EQ_STRING('', jiec_concat(''));
END_TEST_S

TEST_S(test_jiec_quote)
	var
		long_text: string[STRING_MAX_SIZE];
		quoted: string[STRING_MAX_SIZE];
		index: dint;
	end
	// Fact: jiec_quote encloses a plain string in quote characters.
		// Arrange/Act/Assert
	EXPECT_EQ_STRING('$'abc$'', jiec_quote('abc'));

	// Fact: jiec_quote of an empty string is two quote characters.
		// Arrange/Act/Assert
	EXPECT_EQ_STRING('$'$'', jiec_quote(''));

	// Fact: jiec_quote escapes quote characters and dollar signs with a dollar sign.
		// Arrange/Act/Assert
	EXPECT_EQ_STRING('$'$$$'$$$$$'', jiec_quote('$'$$'));

	// Fact: jiec_quote keeps the other characters, including spaces at the end.
		// Arrange/Act/Assert
	EXPECT_EQ_STRING('$'a b  $'', jiec_quote('a b  '));

	// Fact: jiec_quote cuts off a string that does not fit and marks it with three dots after the closing quote.
		// Arrange
	long_text := '';
	for index := 1 to STRING_MAX_SIZE do
		long_text := concat(long_text, 'x');
	end_for;
		// Act
	quoted := jiec_quote(long_text);
		// Assert
	// (One less than STRING_MAX_SIZE: on OMRON the size of a STRING includes the terminator.)
	EXPECT_EQ_INT(STRING_MAX_SIZE - 1, len(quoted));
	EXPECT_EQ_STRING('$'...', right(quoted, 4));
	EXPECT_EQ_STRING('$'x', left(quoted, 2));
END_TEST_S
