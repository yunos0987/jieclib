(*
 * Test for Math_gcd
 * $ cd <JiecLib Project Root>
 * $ jiecc ./test/math/test_gcd.iec -I./src -I./vendor/jiecunit -D_TEST_ -o ./test/math/test_gcd.xml -t omron
 *
 * The expected values come from math.gcd of Python.
 *)
{#if _JIECC and (_JIECC_FULL_VER < 90200)}
{#error JiecLib requires Jiecc 9.2.0 or later.}
{#endif}
{#include <jiecunit.iec>}
{#if _JIECUNIT and (_JIECUNIT_VER < 402)}
	{#error This test requires JiecUnit 4.2 or later.}
{#endif}

{#include <math/gcd.iec>}

{#ifdef _TEST_}
DEFINE_CONFIGURATION(
	_JIEC_TESTNAMES_LIST_(
		test_gcd
	)
)
{#endif}

TEST_S(test_gcd)
	var
		ok: bool;
	end
	// Fact: gcd of positive and negative integers.
		// Arrange/Act/Assert
	EXPECT_EQ_INT64(6, Math_gcd(num_a:=12, num_b:=18));
	EXPECT_EQ_INT64(6, Math_gcd(num_a:=-12, num_b:=18));
	EXPECT_EQ_INT64(6, Math_gcd(num_a:=12, num_b:=-18));
	EXPECT_EQ_INT64(1, Math_gcd(num_a:=17, num_b:=5));

	// Fact: gcd with 0.
		// Arrange/Act/Assert
	EXPECT_EQ_INT64(5, Math_gcd(num_a:=0, num_b:=5));
	EXPECT_EQ_INT64(5, Math_gcd(num_a:=-5, num_b:=0));
	EXPECT_EQ_INT64(0, Math_gcd(num_a:=0, num_b:=0));

	// Fact: gcd of the largest lint.
		// Arrange/Act/Assert
	EXPECT_EQ_INT64(7, Math_gcd(num_a:=lint#9223372036854775807, num_b:=7));

	// Fact: The smallest lint is an error (its absolute value does not fit in lint).
		// Arrange
		// Act
	Math_gcd(num_a:=lint#-9223372036854775807 - lint#1, num_b:=2, eno=>ok);
		// Assert
	EXPECT_FALSE(ok);
END_TEST_S
