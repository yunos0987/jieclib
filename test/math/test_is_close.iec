(*
 * Test for Math_isClose
 * $ cd <JiecLib Project Root>
 * $ jiecc ./test/math/test_is_close.iec -I./src -I./vendor/jiecunit -D_TEST_ -o ./test/math/test_is_close.xml -t omron
 *
 * The expected values come from math.isclose of Python.
 *)
{#if _JIECC and (_JIECC_FULL_VER < 90200)}
{#error JiecLib requires Jiecc 9.2.0 or later.}
{#endif}
{#include <jiecunit.iec>}
{#if _JIECUNIT and (_JIECUNIT_VER < 402)}
	{#error This test requires JiecUnit 4.2 or later.}
{#endif}

{#include <math/is_close.iec>}

{#ifdef _TEST_}
DEFINE_CONFIGURATION(
	_JIEC_TESTNAMES_LIST_(
		test_is_close
	)
)
{#endif}

TEST_S(test_is_close)
	var
		ok: bool;
	end
	// Fact: Values within the relative tolerance (default 1.0e-9) are close.
		// Arrange/Act/Assert
	EXPECT_TRUE(Math_isClose(value_a:=1.0, value_b:=1.0000000001));
	EXPECT_TRUE(Math_isClose(value_a:=1000000000.0, value_b:=1000000001.0));
	EXPECT_FALSE(Math_isClose(value_a:=1.0, value_b:=1.1));
	EXPECT_FALSE(Math_isClose(value_a:=1000000000.0, value_b:=1000000002.0));

	// Fact: Near 0 only the absolute tolerance helps.
		// Arrange/Act/Assert
	EXPECT_FALSE(Math_isClose(value_a:=0.0, value_b:=1e-10));
	EXPECT_TRUE(Math_isClose(value_a:=0.0, value_b:=1e-10, rel_tol:=1e-09, abs_tol:=1e-09));

	// Fact: Equal values are close even with zero tolerances, including the largest lreal.
		// Arrange/Act/Assert
	EXPECT_TRUE(Math_isClose(value_a:=1.7976931348623157e+308, value_b:=1.7976931348623157e+308, rel_tol:=0.0, abs_tol:=0.0));
	EXPECT_TRUE(Math_isClose(value_a:=0.0, value_b:=0.0, rel_tol:=0.0, abs_tol:=0.0));

	// Fact: A negative tolerance is an error.
		// Arrange
		// Act
	Math_isClose(value_a:=1.0, value_b:=1.0, rel_tol:=-1.0, eno=>ok);
		// Assert
	EXPECT_FALSE(ok);

	Math_isClose(value_a:=1.0, value_b:=1.0, abs_tol:=-1.0, eno=>ok);
	EXPECT_FALSE(ok);
END_TEST_S
