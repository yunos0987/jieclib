(*
 * Tests of the console of src/sys.iec (roadmap PR-7).
 * $ cd <JiecLib Project Root>
 * $ jiecc ./test/test_sys_console.iec -I. -I./src -I./vendor/jiecunit -D_TEST_ -o ./test/test_sys_console.xml -t omron
 *)
{#include <jiecunit.iec>}
{#if _JIECUNIT and (_JIECUNIT_VER < 402)}
	{#error This test requires JiecUnit 4.2 or later.}
{#endif}

{#include <sys.iec>}

{#ifdef _TEST_}
DEFINE_CONFIGURATION(
	_JIEC_TESTNAMES_LIST_(
		test_Console_print
	)
)
{#endif}

TEST_S(test_Console_print)
	var
		con: Console_t;
	end
	// Fact: Console_print appends the text to the current row without moving to the next row.
		// Arrange
	Console_initialize(con);
		// Act
	Console_print(con, 'ab');
	Console_print(con, 'cd');
		// Assert
	EXPECT_EQ_STRING('abcd', con.rows[0]);
	EXPECT_EQ_DINT(0, con.row_index);

	// Fact: After Console_puts moves to the next row, Console_print writes to that row.
		// Arrange
	Console_puts(con, 'line');
		// Act
	Console_print(con, 'x');
		// Assert
	EXPECT_EQ_STRING('line', con.rows[0]);
	EXPECT_EQ_STRING('x', con.rows[1]);
	EXPECT_EQ_DINT(1, con.row_index);
END_TEST_S
