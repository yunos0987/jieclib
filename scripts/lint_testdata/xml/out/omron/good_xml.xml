<Function name="Good_fill_record">
	<Documentation xsi:type="SimpleText">Fills a structure through var_in_out instead of returning it.</Documentation>
	<ResultType><TypeName>bool</TypeName></ResultType>
	<Parameters>
	<InoutVars>
		<Variable name="values" orderWithinParamSet="1">
			<Documentation xsi:type="SimpleText">The variable-length array is a var_in_out parameter.</Documentation>
			<Type><InstantlyDefinedType xsi:type="ArrayTypeSpec"><BaseType><TypeName>dint</TypeName></BaseType><DimensionSpec dimensionNumber="1"><VariableLength>true</VariableLength></DimensionSpec></InstantlyDefinedType></Type>
		</Variable>
	</InoutVars>
	<InoutVars>
		<Variable name="record" orderWithinParamSet="2">
			<Documentation xsi:type="SimpleText">The record to fill.</Documentation>
			<Type><TypeName>Good_record_t</TypeName></Type>
		</Variable>
	</InoutVars>
	<InputVars>
		<Variable name="high_value" orderWithinParamSet="3">
			<Documentation xsi:type="SimpleText">A name with an underscore.</Documentation>
			<Type><TypeName>dint</TypeName></Type>
		</Variable>
	</InputVars>
	</Parameters>
	<MainBody>
		<BodyContent xsi:type="ST"><ST>	record.total_value := values[lower_bound(values, 1)] + high_value;
	Good_fill_record := true;
</ST></BodyContent>
	</MainBody>
</Function>
