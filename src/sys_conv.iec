{#ifndef __SYS_CONV_IEC__}
{#define __SYS_CONV_IEC__}

{#include "sys.iec"}

{#if _KEYENCE}
	{#define word uint}
	{#define int_to_word(...) int_to_uint(__VA_ARGS__)}
	{#define uint_to_word(...) uint_to_uint(__VA_ARGS__)}
	{#define word_to_int(...) uint_to_int(__VA_ARGS__)}
	{#define word_to_uint(...) uint_to_uint(__VA_ARGS__)}

	{#define dword udint}
	{#define dint_to_dword(...) dint_to_udint(__VA_ARGS__)}
	{#define udint_to_dword(...) udint_to_udint(__VA_ARGS__)}
	{#define dword_to_dint(...) udint_to_dint(__VA_ARGS__)}
	{#define dword_to_udint(...) udint_to_udint(__VA_ARGS__)}

	(*{doc Convert a 32-bit signed integer to a decimal string representation.
	@input in The 32-bit signed integer to convert.
	@return The string representation of the input value.}*)
	function dint_to_string: string[16]
		_PROLOGUE_OF_FUNCTION_FOR_SYS_();
		var_input
			(*{doc The 32-bit signed integer to convert.}*)
			in: dint;
		end
		dint_to_string := NumToDecString(in:=in, zerosuppress:=true, plussignomission:=true);
	end

	(*{doc Convert a 32-bit unsigned integer to a decimal string representation.
	@input in The 32-bit unsigned integer to convert.
	@return The string representation of the input value.}*)
	function udint_to_string: string[16]
		_PROLOGUE_OF_FUNCTION_FOR_SYS_();
		var_input
			(*{doc The 32-bit unsigned integer to convert.}*)
			in: udint;
		end
		udint_to_string := NumToDecString(in:=in, zerosuppress:=true, plussignomission:=true);
	end

	(*{doc Convert a 64-bit floating-point value to a string representation.
	@input in The 64-bit floating-point value to convert.
	@return The string representation of the input value.}*)
	function lreal_to_string: string[32]
		_PROLOGUE_OF_FUNCTION_FOR_SYS_();
		var_input
			(*{doc The 64-bit floating-point value to convert.}*)
			in: lreal;
		end
		lreal_to_string := LrealToString(in:=in, format:=1, fullcount:=24, subdeccount:=14);
	end

	{#define dword_to_string(...) udint_to_string(__VA_ARGS__)}
{#endif}

{#if not (_CODESYS)}
(*{doc Convert a boolean value to a string representation.
@input in The boolean value to convert.
@return 'true' if the input is true, 'false' otherwise.}*)
function bool_to_string: string[8]
	_PROLOGUE_OF_FUNCTION_FOR_SYS_();
	var_input
		(*{doc The boolean value to convert.}*)
		in: bool;
	end
	if in then
		bool_to_string := 'true';
	else
		bool_to_string := 'false';
	end_if;
end
{#endif}

{#if _OMRON}
	{#define time_to_usec_dint(...) lint_to_dint(TimeToNanoSec(__VA_ARGS__) / lint#1000)}
{#elif _KEYENCE}
	{#define time_to_usec_dint(...) TimeToMicroSec(__VA_ARGS__)}
{#elif _CODESYS}
	{#define time ltime}
	{#define TIME ltime}
	{#define time_to_usec_dint(...) lint_to_dint(ltime_to_lint(__VA_ARGS__) / lint#1000)}
{#endif}

{#if not (_MITSUBISHI)}
// The sum and the difference of two TIME values. Sysmac Studio (OMRON) has no
// + and - for TIME, so the standard functions ADD_TIME / SUB_TIME are used;
// CODESYS has the operators only.
{#if _CODESYS}
	{#define jiec_add_time(lhs_, rhs_) ((lhs_) + (rhs_))}
	{#define jiec_sub_time(lhs_, rhs_) ((lhs_) - (rhs_))}
{#else}
	{#define jiec_add_time(lhs_, rhs_) add_time(lhs_, rhs_)}
	{#define jiec_sub_time(lhs_, rhs_) sub_time(lhs_, rhs_)}
{#endif}

(*{doc How many times a duration contains a unit, rounded down.
Uses only the addition (ADD_TIME), the subtraction (SUB_TIME) and the comparison of TIME values:
the PLC tools do not multiply or divide a TIME value by a number. It works
without 64-bit integers and never computes a duration longer than value.
@input value The duration; must not be negative.
@input unit The unit; must be positive.
@return The number of whole units in value (at most 2147483647).}*)
function jiec_time_quotient: dint
	_PROLOGUE_OF_FUNCTION_FOR_SYS_();
	var_input
		(*{doc The duration; must not be negative.}*)
		value: time;
		(*{doc The unit; must be positive.}*)
		unit: time;
	end
	var_temp
		remaining: time;
		chunk: time;
		chunk_count: dint;
	end
	jiec_time_quotient := 0;
	remaining := value;
	while remaining >= unit do
		// Take the largest unit * 2^k that fits (the subtraction avoids a
		// duration above the range of TIME).
		chunk := unit;
		chunk_count := 1;
		while chunk_count < 1073741824 do
			if jiec_sub_time(remaining, chunk) < chunk then
				exit;
			end_if;
			chunk := jiec_add_time(chunk, chunk);
			chunk_count := chunk_count * 2;
		end_while;
		if jiec_time_quotient > 2147483647 - chunk_count then
			jiec_time_quotient := 2147483647;
			return;
		end_if;
		remaining := jiec_sub_time(remaining, chunk);
		jiec_time_quotient := jiec_time_quotient + chunk_count;
	end_while;
end

(*{doc What is left of a duration after taking out the whole units.
The counterpart of jiec_time_quotient, with the same restrictions: the PLC
tools do not multiply or divide a TIME value by a number, so the remainder
is computed with subtractions and comparisons too.
@input value The duration; must not be negative.
@input unit The unit; must be positive.
@return value minus the whole units in it (less than unit).}*)
function jiec_time_remainder: time
	_PROLOGUE_OF_FUNCTION_FOR_SYS_();
	var_input
		(*{doc The duration; must not be negative.}*)
		value: time;
		(*{doc The unit; must be positive.}*)
		unit: time;
	end
	var_temp
		remaining: time;
		chunk: time;
		chunk_count: dint;
	end
	remaining := value;
	while remaining >= unit do
		chunk := unit;
		chunk_count := 1;
		while chunk_count < 1073741824 do
			if jiec_sub_time(remaining, chunk) < chunk then
				exit;
			end_if;
			chunk := jiec_add_time(chunk, chunk);
			chunk_count := chunk_count * 2;
		end_while;
		remaining := jiec_sub_time(remaining, chunk);
	end_while;
	jiec_time_remainder := remaining;
end

// The nanoseconds of a duration shorter than a second, as DINT.
{#if _OMRON}
	{#define _jiec_subsecond_to_nsec(...) lint_to_dint(TimeToNanoSec(__VA_ARGS__))}
{#elif _KEYENCE}
	{#define _jiec_subsecond_to_nsec(...) (TimeToMicroSec(__VA_ARGS__) * 1000)}
{#elif _CODESYS}
	{#define _jiec_subsecond_to_nsec(...) lint_to_dint(ltime_to_lint(__VA_ARGS__))}
{#else}
	// jier has only time_to_usec_dint, which drops what is below a
	// microsecond: count the nanoseconds that are left.
	{#define _jiec_subsecond_to_nsec(...) (time_to_usec_dint(__VA_ARGS__) * 1000 + jiec_time_quotient(jiec_time_remainder(__VA_ARGS__, time#0.001ms), time#0.000001ms))}
{#endif}

(*{doc Convert a time value to text in the form of a duration literal of IEC 61131-3.
The form is "T#[-][<d>d][<h>h][<m>m][<s>s][<ms>ms]", for example
"T#1h30m5s250ms"; a part that is 0 is left out, and 0 is "T#0s". A fraction of
a millisecond is written with a decimal point, down to nanoseconds
("T#250.123456ms"); the units us and ns are not used. Unlike a conversion
through an integer of microseconds, long durations are not cut off.
@input in The time value to convert.
@return The text.}*)
function time_to_literal: string[64]
	_PROLOGUE_OF_FUNCTION_FOR_SYS_();
	var_input
		(*{doc The time value to convert.}*)
		in: time;
	end
	var_temp
		remaining: time;
		days: dint;
		seconds: dint;
		nsec: dint;
		ms_fraction: dint;
		ms_fraction_str: string[16];
		literal: string[64];
	end
	literal := 'T#';
	remaining := in;
	if in < time#0s then
		literal := 'T#-';
		remaining := jiec_sub_time(time#0s, in);
	end_if;
	if remaining = time#0s then
		time_to_literal := 'T#0s';
		return;
	end_if;

	// (The PLC tools do not multiply or divide a TIME value by a number, so
	// the value is split with jiec_time_quotient / jiec_time_remainder.)
	days := jiec_time_quotient(remaining, time#1d);
	if days > 0 then
		remaining := jiec_time_remainder(remaining, time#1d);
		literal := jiec_concat(literal, dint_to_string(days), 'd');
	end_if;
	// Less than a day is left.
	seconds := jiec_time_quotient(remaining, time#1s);
	remaining := jiec_time_remainder(remaining, time#1s);
	if seconds >= 3600 then
		literal := jiec_concat(literal, dint_to_string(seconds / 3600), 'h');
		seconds := seconds mod 3600;
	end_if;
	if seconds >= 60 then
		literal := jiec_concat(literal, dint_to_string(seconds / 60), 'm');
		seconds := seconds mod 60;
	end_if;
	if seconds > 0 then
		literal := jiec_concat(literal, dint_to_string(seconds), 's');
	end_if;
	// Less than a second is left: its nanoseconds fit in a DINT.
	nsec := _jiec_subsecond_to_nsec(remaining);
	ms_fraction := nsec mod 1000000;
	if nsec > 0 then
		literal := jiec_concat(literal, dint_to_string(nsec / 1000000));
		if ms_fraction > 0 then
			ms_fraction_str := dint_to_string(ms_fraction);
			while len(ms_fraction_str) < 6 do
				ms_fraction_str := jiec_concat('0', ms_fraction_str);
			end_while;
			while right(ms_fraction_str, 1) = '0' do
				ms_fraction_str := left(ms_fraction_str, len(ms_fraction_str) - 1);
			end_while;
			literal := jiec_concat(literal, '.', ms_fraction_str);
		end_if;
		literal := jiec_concat(literal, 'ms');
	end_if;
	time_to_literal := literal;
end
