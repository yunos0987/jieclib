(*
	================================================================================
	Median filter template
	================================================================================

	This template generates a function block that outputs the median of the
	last N inputs (N is an odd macro value, so that the median is one input).

	Required macros:
	  - SignalMedianName
	    Suffix of the function block name.
	  - SignalMedianCapacity
	    N, the number of inputs (odd, 1 or more).

	Generated API:
	  - Signal_median_@@SignalMedianName (function block)
	      inputs: input_value, reset; outputs: output_value, filled_count

	Example:
	  {#define SignalMedianName n5}
	  {#define SignalMedianCapacity 5}
	  {#include <signal/median_template.iec>}
	  {#undef SignalMedianName}
	  {#undef SignalMedianCapacity}
	  // var mf: Signal_median_n5; end
	  // mf(input_value:=x); y := mf.output_value;
	================================================================================
*)
{#include <sys.iec>}

{#ifndef SignalMedianName}
	{#error require SignalMedianName macro.}
{#endif}
{#ifndef SignalMedianCapacity}
	{#error require SignalMedianCapacity macro.}
{#endif}
{#if (SignalMedianCapacity < 1) or ((SignalMedianCapacity mod 2) = 0)}
	{#error The capacity of the median filter must be an odd number (1, 3, 5, ...).}
{#endif}

{#define _SIGNAL_MEDIAN_(T) Signal_median_@@T}
{#define SIGNAL_MEDIAN(T) _SIGNAL_MEDIAN_(T)}
{#define Signal_median SIGNAL_MEDIAN(SignalMedianName)}

(*{doc Median filter: the median of the last N inputs (N = SignalMedianCapacity, odd).
It removes short spikes that a moving average would spread.
Until N inputs have been given, it outputs the median of the inputs given so far
(for an even number of inputs, the mean of the two middle ones).
Each call sorts a copy of the kept inputs (insertion sort, about N^2 / 4 comparisons).
@input input_value The new input.
@input reset True to forget the kept inputs; the input of the same call is then the first one.
@output output_value The median of the kept inputs.
@output filled_count The number of kept inputs (1 to N).}*)
function_block Signal_median
	_PROLOGUE_OF_FUNCTION_()
	var_input
		(*{doc The new input.}*)
		input_value: lreal;
		(*{doc True to forget the kept inputs.}*)
		reset: bool;
	end
	var_output
		(*{doc The median of the kept inputs.}*)
		output_value: lreal;
		(*{doc The number of kept inputs.}*)
		filled_count: dint;
	end
	var
		kept: array[0..SignalMedianCapacity - 1] of lreal;
		next_index: dint;
	end
	var_temp
		sorted: array[0..SignalMedianCapacity - 1] of lreal;
		idx: dint;
		pos: dint;
		value: lreal;
		half: dint;
	end
	if reset then
		filled_count := 0;
		next_index := 0;
	end_if;
	kept[next_index] := input_value;
	next_index := (next_index + 1) mod SignalMedianCapacity;
	if filled_count < SignalMedianCapacity then
		filled_count := filled_count + 1;
	end_if;
	// Insertion sort of the kept inputs into sorted[0..filled_count - 1].
	for idx := 0 to filled_count - 1 do
		value := kept[idx];
		pos := idx;
		while (pos > 0) and (sorted[pos - 1] > value) do
			sorted[pos] := sorted[pos - 1];
			pos := pos - 1;
		end_while;
		sorted[pos] := value;
	end_for;
	half := filled_count / 2;
	if (filled_count mod 2) = 1 then
		output_value := sorted[half];
	else
		output_value := (sorted[half - 1] + sorted[half]) / 2.0;
	end_if;
end_function_block

{#undef _SIGNAL_MEDIAN_}
{#undef SIGNAL_MEDIAN}
{#undef Signal_median}
